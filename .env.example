# ==============================================================================
# Proofly Environment Variables Template (.env.example)
# ==============================================================================
# NOTICE: NEVER put real private keys or production credentials in this file.
# Copy this file to .env and provide your own values for local development.
# .env is gitignored and must never be committed.

# --- Zero-Knowledge & World ID ---
NEXT_PUBLIC_WORLD_APP_ID=app_placeholder_id
NEXT_PUBLIC_WORLD_ID_ACTION=proofly-human-verify
WORLD_ID_ACTION=proofly-human-verify
NEXT_PUBLIC_WORLD_RP_ID=rp_placeholder_id
RP_SIGNING_KEY=0xREPLACE_WITH_ROTATED_TEST_KEY_NEVER_COMMIT
VITE_WORLD_RP_ID=rp_placeholder_id
VITE_WORLD_APP_ID=app_placeholder_id
VITE_WORLD_ACTION=proofly-human-verify

# --- Database (Neon / Supabase Postgres) ---
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/neondb?sslmode=require

# --- EVM RPC & Network (Base Sepolia) ---
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_BASE_MAINNET_RPC_URL=https://mainnet.base.org
VITE_PROOFLY_API_BASE_URL=http://localhost:3000

# --- Deployed Smart Contracts (Base Sepolia) ---
NEXT_PUBLIC_PROOFLY_REGISTRY_ADDRESS=0x7c2e142C203f43C5e6F9206A5c66b8A8DA9BF997
NEXT_PUBLIC_PROOFLY_POLICY_ADDRESS=0xd7b102FaCe7b18DE434a9eaF2D3CE7c2BE8ec97E
NEXT_PUBLIC_PROOFLY_SESSION_ADDRESS=0x5548E68dD468123BB4d0FB403B5F1402d1b0A9Cf
NEXT_PUBLIC_PROOFLY_TASK_GATE_ADDRESS=0x32cC06E48B61F22a41956a913101d1A9bCb70572

VITE_PROOFLY_REGISTRY_ADDRESS=0x7c2e142C203f43C5e6F9206A5c66b8A8DA9BF997
VITE_PROOFLY_POLICY_ADDRESS=0xd7b102FaCe7b18DE434a9eaF2D3CE7c2BE8ec97E
VITE_PROOFLY_SESSION_ADDRESS=0x5548E68dD468123BB4d0FB403B5F1402d1b0A9Cf
VITE_PROOFLY_TASK_GATE_ADDRESS=0x32cC06E48B61F22a41956a913101d1A9bCb70572

# --- Deployment / Relayer Key (Local Testnet Only) ---
# WARNING: Must be a disposable testnet key with minimal test funds.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_DISPOSABLE_TEST_PRIVATE_KEY
BASESCAN_API_KEY=
